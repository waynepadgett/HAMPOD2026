+    memset(&val, 0, sizeof(val));
+
+    int retcode = rig_get_level(g_rig, RIG_VFO_CURR, RIG_LEVEL_KEYSPD, &val);
+
+    pthread_mutex_unlock(&g_rig_mutex);
+
+    if (retcode != RIG_OK) {
+        DEBUG_PRINT("radio_get_keyer_speed: %s\n", rigerror(retcode));
+        return -999;
+    }
+
+    return val.i;   // WPM
+}
