+int radio_set_vox_status(bool enable)
+{
+    pthread_mutex_lock(&g_rig_mutex);
+
+    if (!g_connected || !g_rig) {
+        pthread_mutex_unlock(&g_rig_mutex);
+        DEBUG_PRINT("radio_set_vox_status: not connected\n");
+        return -1;
+    }
+
+    int retcode = rig_set_func(
+        g_rig,
+        RIG_VFO_CURR,
+        RIG_FUNC_VOX,
